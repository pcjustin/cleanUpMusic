<UserControl x:Class="CleanUpMusic.MojibakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CleanUpMusic">
    <UserControl.Resources>
        <local:RowTemplates x:Key="Templates">
            <local:RowTemplates.Header>
                <DataTemplate x:DataType="local:Row">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Toggle" Padding="4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind ExpandName}">
                            <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="10" />
                        </Button>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="Check" MinWidth="0" />
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </local:RowTemplates.Header>
            <local:RowTemplates.Item>
                <DataTemplate x:DataType="local:Row">
                    <Grid Margin="32,0,0,0" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsChecked, Mode=OneWay}" Click="Check" MinWidth="0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Old}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="→" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{x:Bind New}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </local:RowTemplates.Item>
        </local:RowTemplates>
    </UserControl.Resources>
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton" Content="掃描亂碼檔名" Click="Scan" />
            <TextBlock x:Name="Help" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="檔名或資料夾名稱被用錯的編碼讀成亂碼（如 Shift-JIS、GBK、Big5 被當成西歐或 DOS 編碼）時，改回正確的文字" />
            <Button Grid.Column="2" Content="全選" Click="SelectAll" />
            <Button Grid.Column="3" Content="全不選" Click="SelectNone" />
            <Button x:Name="ApplyButton" Grid.Column="4" Click="Apply" />
        </Grid>
        <ListView x:Name="List" Grid.Row="1" SelectionMode="None" ItemTemplateSelector="{StaticResource Templates}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="32" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
