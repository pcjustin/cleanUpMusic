<Application x:Class="CleanUpMusic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- SwiftUI's .green / .orange and caption sizes; .secondary is TextFillColorSecondaryBrush. -->
            <SolidColorBrush x:Key="GreenBrush" Color="#FF28A745" />
            <SolidColorBrush x:Key="OrangeBrush" Color="#FFFF9500" />
            <x:Double x:Key="CaptionSize">11</x:Double>
            <x:Double x:Key="Caption2Size">10</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
