<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Uses the installed .NET Desktop Runtime and Windows App Runtime; the release zip carries their installers. -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en-US;zh-TW;zh-CN</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Swift core, the Swift runtime and OpenCC's data, staged by build.ps1. -->
    <Content Include="..\native\**\*" LinkBase="." CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
